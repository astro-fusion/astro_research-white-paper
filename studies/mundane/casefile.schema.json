{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "studies/mundane/casefile.schema.json",
  "title": "Mundane case file (ADR-006 section 6.4)",
  "type": "object",
  "required": [
    "schema",
    "event",
    "chart",
    "settings",
    "natal",
    "dasha",
    "transits",
    "event_sky",
    "annual",
    "factors",
    "claims",
    "provenance",
    "sections"
  ],
  "additionalProperties": false,
  "properties": {
    "schema": {
      "const": "casefile/1"
    },
    "event": {
      "type": "object",
      "required": [
        "event_id",
        "title",
        "event_type",
        "time_utc",
        "time_precision",
        "lat",
        "lon",
        "severity",
        "source_url",
        "archive_url",
        "catalogue",
        "exhaustive"
      ],
      "properties": {
        "event_id": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "event_type": {
          "type": "string"
        },
        "subtype": {
          "type": [
            "string",
            "null"
          ]
        },
        "time_utc": {
          "type": "string"
        },
        "time_precision": {
          "enum": [
            "minute",
            "hour",
            "day",
            "month"
          ]
        },
        "lat": {
          "type": [
            "number",
            "null"
          ]
        },
        "lon": {
          "type": [
            "number",
            "null"
          ]
        },
        "severity": {
          "type": "object"
        },
        "source_url": {
          "type": [
            "string",
            "null"
          ]
        },
        "archive_url": {
          "type": [
            "string",
            "null"
          ]
        },
        "catalogue": {
          "type": "object"
        },
        "exhaustive": {
          "type": "boolean"
        }
      }
    },
    "chart": {
      "type": "object",
      "required": [
        "chart_id",
        "grade",
        "half_window_minutes",
        "founding_date",
        "founding_time",
        "time_zone",
        "place",
        "lat",
        "lon",
        "valid_from"
      ],
      "properties": {
        "chart_id": {
          "type": "string"
        },
        "grade": {
          "enum": [
            "A",
            "B",
            "C",
            "D",
            "R",
            "X"
          ]
        },
        "half_window_minutes": {
          "type": [
            "number",
            "null"
          ]
        },
        "founding_date": {
          "type": "string"
        },
        "founding_time": {
          "type": [
            "string",
            "null"
          ]
        },
        "time_zone": {
          "type": "string"
        },
        "place": {
          "type": "string"
        },
        "lat": {
          "type": "number"
        },
        "lon": {
          "type": "number"
        },
        "time_evidence_kind": {
          "type": [
            "string",
            "null"
          ]
        },
        "valid_from": {
          "type": "string"
        }
      }
    },
    "settings": {
      "type": "object",
      "required": [
        "ayanamsa",
        "node",
        "houses",
        "dasha_year"
      ],
      "properties": {
        "ayanamsa": {
          "type": "string"
        },
        "node": {
          "type": "string"
        },
        "houses": {
          "type": "string"
        },
        "dasha_year": {
          "type": "string"
        }
      }
    },
    "natal": {
      "allOf": [
        {
          "$ref": "#/$defs/section"
        }
      ],
      "type": "object",
      "required": [
        "points"
      ],
      "properties": {
        "points": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "point",
              "longitude",
              "vargas"
            ],
            "properties": {
              "point": {
                "type": "string"
              },
              "longitude": {
                "type": "number"
              },
              "degree_in_sign": {
                "type": "number"
              },
              "nakshatra": {
                "type": "string"
              },
              "pada": {
                "type": "integer"
              },
              "retrograde": {
                "type": [
                  "boolean",
                  "null"
                ]
              },
              "combust": {
                "type": [
                  "boolean",
                  "null"
                ]
              },
              "point_stable": {
                "type": "boolean"
              },
              "vargas": {
                "type": "object",
                "additionalProperties": {
                  "type": "object",
                  "required": [
                    "sign",
                    "house",
                    "stable",
                    "alternatives"
                  ],
                  "properties": {
                    "sign": {
                      "type": "string"
                    },
                    "house": {
                      "type": [
                        "integer",
                        "null"
                      ]
                    },
                    "dignity": {
                      "type": [
                        "array",
                        "null"
                      ]
                    },
                    "hora_lord": {
                      "type": [
                        "string",
                        "null"
                      ]
                    },
                    "stable": {
                      "type": "boolean"
                    },
                    "alternatives": {
                      "type": "array"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "dasha": {
      "allOf": [
        {
          "$ref": "#/$defs/section"
        }
      ],
      "type": "object",
      "required": [
        "levels"
      ],
      "properties": {
        "levels": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "level",
              "name",
              "lord",
              "stable",
              "supported"
            ],
            "properties": {
              "level": {
                "type": "integer"
              },
              "name": {
                "type": "string"
              },
              "lord": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "start": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "end": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "boundary_uncertainty_days": {
                "type": [
                  "number",
                  "null"
                ]
              },
              "stable": {
                "type": "boolean"
              },
              "supported": {
                "type": "boolean"
              },
              "reason": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    "transits": {
      "allOf": [
        {
          "$ref": "#/$defs/section"
        }
      ],
      "type": "object",
      "required": [
        "positions",
        "readings"
      ],
      "properties": {
        "positions": {
          "type": "array"
        },
        "readings": {
          "type": "object",
          "required": [
            "core",
            "extended"
          ]
        }
      }
    },
    "event_sky": {
      "allOf": [
        {
          "$ref": "#/$defs/section"
        }
      ],
      "type": "object"
    },
    "annual": {
      "allOf": [
        {
          "$ref": "#/$defs/section"
        }
      ],
      "type": "object"
    },
    "factors": {
      "allOf": [
        {
          "$ref": "#/$defs/section"
        }
      ],
      "type": "object",
      "required": [
        "rows",
        "not_evaluated"
      ],
      "properties": {
        "rows": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "factor_id",
              "method",
              "methods",
              "citation_status",
              "level",
              "tier",
              "fired",
              "stable",
              "base_rate",
              "evidence"
            ],
            "properties": {
              "factor_id": {
                "type": "string"
              },
              "method": {
                "type": "string"
              },
              "methods": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "object",
                  "required": [
                    "id",
                    "tier",
                    "citation_status",
                    "level"
                  ],
                  "properties": {
                    "id": {
                      "type": "string"
                    },
                    "tier": {
                      "enum": [
                        "core",
                        "extended",
                        "phase2",
                        "phase3"
                      ]
                    },
                    "tradition": {
                      "type": "string"
                    },
                    "citation_status": {
                      "enum": [
                        "unverified",
                        "page_cited",
                        "verified"
                      ]
                    },
                    "level": {
                      "type": "string"
                    }
                  }
                }
              },
              "citation_status": {
                "enum": [
                  "unverified",
                  "page_cited",
                  "verified"
                ]
              },
              "level": {
                "type": "string"
              },
              "tier": {
                "type": "string"
              },
              "fired": {
                "const": true
              },
              "stable": {
                "type": "boolean"
              },
              "evidence": {
                "type": "string"
              },
              "base_rate": {
                "type": "object",
                "required": [
                  "value",
                  "reason"
                ],
                "properties": {
                  "value": {
                    "type": [
                      "number",
                      "null"
                    ]
                  },
                  "reason": {
                    "type": [
                      "string",
                      "null"
                    ]
                  }
                }
              }
            }
          }
        },
        "not_evaluated": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "test_id",
              "reason"
            ],
            "properties": {
              "test_id": {
                "type": "string"
              },
              "reason": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    "claims": {
      "allOf": [
        {
          "$ref": "#/$defs/section"
        }
      ],
      "type": "object",
      "required": [
        "rows"
      ],
      "properties": {
        "rows": {
          "type": "array"
        }
      }
    },
    "provenance": {
      "type": "object",
      "required": [
        "charts_sha256",
        "events_sha256",
        "catalogue_sha256",
        "plan_sha256",
        "ayanamsa",
        "node",
        "houses",
        "dasha_year",
        "commit"
      ],
      "properties": {
        "charts_sha256": {
          "type": "string"
        },
        "events_sha256": {
          "type": "string"
        },
        "catalogue_sha256": {
          "type": "string"
        },
        "plan_sha256": {
          "type": "string"
        },
        "ayanamsa": {
          "type": "string"
        },
        "node": {
          "type": "string"
        },
        "houses": {
          "type": "string"
        },
        "dasha_year": {
          "type": "string"
        },
        "commit": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "sections": {
      "type": "array",
      "minItems": 9,
      "items": {
        "type": "object",
        "required": [
          "number",
          "key",
          "title",
          "computable",
          "reason"
        ],
        "properties": {
          "number": {
            "type": "integer"
          },
          "key": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "computable": {
            "type": "boolean"
          },
          "reason": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    }
  },
  "$defs": {
    "section": {
      "type": "object",
      "required": [
        "computable",
        "reason"
      ],
      "properties": {
        "computable": {
          "type": "boolean"
        },
        "reason": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "if": {
        "properties": {
          "computable": {
            "const": true
          }
        }
      },
      "then": {
        "properties": {
          "reason": {
            "type": "null"
          }
        }
      },
      "else": {
        "properties": {
          "reason": {
            "type": "string"
          }
        }
      }
    }
  }
}
