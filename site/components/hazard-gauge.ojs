// Hazard-rate gauge: one pre-registered rate ratio on a log scale from 1/4
// to 4, with its 95% interval as a band and "no change" (1) marked. It shows
// a registered result; it never computes one.
//
// hazardGauge({rr, lo, hi, label, palette, width})

hazardGauge = ({ rr, lo, hi, label = "", palette, width = 280 } = {}) => {
  const h = width * 0.5 + 70;
  const r = width / 2 - 16;
  const cx = width / 2;
  const cy = r + 20;
  const min = 0.25, max = 4;
  const clamp = (v) => Math.max(min, Math.min(max, v));
  const scale = d3.scaleLog().domain([min, max]).range([Math.PI, 0]);
  const arc = d3.arc().innerRadius(r - 14).outerRadius(r);
  const svg = d3.create("svg")
    .attr("viewBox", [0, 0, width, h])
    .attr("width", width)
    .attr("height", h)
    .attr("role", "img")
    .attr("aria-label", `Rate ratio ${rr == null ? "not available" : rr.toFixed(2)} for ${label}`)
    .style("font", "12px Inter, -apple-system, sans-serif");
  const g = svg.append("g").attr("transform", `translate(${cx},${cy})`);
  const toArc = (a0, a1) => ({ startAngle: Math.PI / 2 - a0, endAngle: Math.PI / 2 - a1 });
  g.append("path").attr("d", arc(toArc(Math.PI, 0))).attr("fill", palette.grid);
  if (Number.isFinite(lo) && Number.isFinite(hi)) {
    g.append("path").attr("d", arc(toArc(scale(clamp(lo)), scale(clamp(hi)))))
      .attr("fill", palette.series[0]).attr("fill-opacity", 0.55)
      .append("title").text(`95% interval ${lo.toFixed(2)} to ${hi.toFixed(2)}`);
  }
  for (const t of [0.25, 0.5, 1, 2, 4]) {
    const a = scale(t);
    const x1 = Math.cos(a) * (r + 2), y1 = -Math.sin(a) * (r + 2);
    const x2 = Math.cos(a) * (r + 7), y2 = -Math.sin(a) * (r + 7);
    g.append("line").attr("x1", x1).attr("y1", y1).attr("x2", x2).attr("y2", y2)
      .attr("stroke", t === 1 ? palette.ink : palette.axis).attr("stroke-width", t === 1 ? 2 : 1);
    g.append("text").attr("x", Math.cos(a) * (r + 14)).attr("y", -Math.sin(a) * (r + 14))
      .attr("text-anchor", "middle").attr("dy", "0.2em").attr("fill", palette.muted)
      .attr("font-size", 10).text(t === 0.25 ? "¼" : t === 0.5 ? "½" : t);
  }
  if (Number.isFinite(rr)) {
    const a = scale(clamp(rr));
    g.append("line").attr("x1", 0).attr("y1", 0)
      .attr("x2", Math.cos(a) * (r - 18)).attr("y2", -Math.sin(a) * (r - 18))
      .attr("stroke", palette.ink).attr("stroke-width", 2).attr("stroke-linecap", "round");
    g.append("circle").attr("r", 4).attr("fill", palette.ink);
  }
  g.append("text").attr("y", 30).attr("text-anchor", "middle")
    .attr("font-size", 22).attr("font-weight", 600).attr("fill", palette.ink)
    .text(Number.isFinite(rr) ? rr.toFixed(2) : "n/a");
  g.append("text").attr("y", 48).attr("text-anchor", "middle")
    .attr("fill", palette.ink2).text("rate ratio (1 = no change)");
  if (label) {
    svg.append("text").attr("x", cx).attr("y", h - 4).attr("text-anchor", "middle")
      .attr("fill", palette.ink2).text(label);
  }
  return svg.node();
}
