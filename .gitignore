# Data: one root (data/). Raw, processed and snapshot files are fetched or
# generated and never committed; see data/README.md for sources and hashes.
data/raw/*
data/processed/*
data/snapshots/*
/data/*.csv
/data/*.parquet
# Study-local data: generated or fetched, documented in each study README.
studies/*/data/*
!studies/earthquake/data/india_nepal_data.json
!**/data/**/README.md
!**/data/**/.gitkeep
!**/data/README.md
!**/data/.gitkeep
# Generated study outputs
studies/*/artifacts/*
!studies/*/artifacts/.gitkeep
docs/_build/

/.quarto/

# macOS
.DS_Store

# ==========================================
# Quarto Build Outputs (LARGE — do not commit)
# ==========================================
# Rendered HTML site, PDFs, figures output by Quarto
_site/
pdfs/
# Frozen execution cache (auto-generated, not source)
_freeze/

# ==========================================
# Generated Research Figures (Large Binaries)
# ==========================================
# Figures produced by analysis scripts are generated artefacts
# Study figures are committed only when a study script produces them and the
# paper references them; everything else goes to studies/<name>/artifacts/.

