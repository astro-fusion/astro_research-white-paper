# Data: one root (data/). Raw, processed and snapshot files are fetched or
# generated and never committed; see data/README.md for sources and hashes.
data/raw/*
data/processed/*
data/snapshots/*
/data/*.csv
/data/*.parquet
# Study-local data: generated or fetched, documented in each study README.
studies/*/data/*
!studies/earthquake/data/india_nepal_data.json
!**/data/**/README.md
!**/data/**/.gitkeep
!**/data/README.md
!**/data/.gitkeep
# Mundane study inputs are hand-curated and committed.
!studies/mundane/data/**
# Generated study outputs. Small summary artifacts the papers read are
# committed; snapshots and large frames (overlay_frame.csv) stay ignored.
studies/*/artifacts/*
!studies/*/artifacts/.gitkeep
!studies/*/artifacts/results.json
!studies/*/artifacts/manifest.json
!studies/*/artifacts/tbl_*.csv
!studies/*/artifacts/fig_*.png
!studies/earthquake/artifacts/catalogue_summary.csv
!studies/earthquake/artifacts/confirmation.csv
!studies/earthquake/artifacts/family_explore.csv
!studies/earthquake/artifacts/rate_tests_all.csv
!studies/earthquake/artifacts/raw_descriptive.csv
docs/_build/

/.quarto/

# macOS
.DS_Store

# ==========================================
# Quarto Build Outputs (LARGE — do not commit)
# ==========================================
# Rendered HTML site, PDFs, figures output by Quarto
_site/
pdfs/
# Frozen execution cache (auto-generated, not source)
_freeze/

# ==========================================
# Generated Research Figures (Large Binaries)
# ==========================================
# Figures produced by analysis scripts are generated artefacts
# Study figures are committed only when a study script produces them and the
# paper references them; everything else goes to studies/<name>/artifacts/.

